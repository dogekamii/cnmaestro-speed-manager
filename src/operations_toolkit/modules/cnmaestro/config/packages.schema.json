{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/dogekamii/cnmaestro-speed-manager/blob/main/packages.schema.json",
  "title":"Operations Toolkit cnMaestro package catalog",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","packages","max_batch_size"],
  "properties":{
    "schema_version":{"const":1},
    "max_batch_size":{"type":"integer","minimum":1},
    "canary_size":{"type":"integer","minimum":1},
    "failure_threshold":{"type":"integer","minimum":1},
    "stop_on_first_issue":{"type":"boolean"},
    "protected_scopes":{"type":"array","items":{"type":"string","pattern":"^(network|tower|ap):.+"}},
    "packages":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["name","template","downlink","uplink"],"properties":{"name":{"type":"string","minLength":1},"template":{"type":"string","minLength":1},"downlink":{"type":"integer","minimum":0},"uplink":{"type":"integer","minimum":0}}}}
  }
}
